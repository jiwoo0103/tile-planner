---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';

const guideOrder = ['how-to-measure-a-room-for-tile', 'tile-waste-allowance', 'tile-box-purchase-example', 'tile-layout-starting-point'];
const guides = (await getCollection('guides'))
  .filter(guide => guideOrder.includes(guide.id))
  .sort((a, b) => guideOrder.indexOf(a.id) - guideOrder.indexOf(b.id));
const tools = [
  { title: 'Tile calculator', href: '/calculator/', image: 'calculator-desktop.png', height: 2055, description: 'Turn room and tile dimensions into an area-based estimate, full boxes to buy and an optional tile-material budget.', link: 'Open calculator', label: '01 / QUANTITIES', alt: 'Actual tile calculator showing room and tile inputs beside tile counts and whole-box estimates.' },
  { title: 'Tile layout planner', href: '/layout/', image: 'layout-desktop.png', height: 2154, description: 'See a straight tile grid in your rectangular room. Compare corner and centered starts, grout spacing and edge cuts.', link: 'Open layout planner', label: '02 / PLACEMENT', alt: 'Actual layout planner showing dimension inputs and a scaled floor plan with full tiles and highlighted edge cuts.' },
];
const steps = [
  { title: 'Measure your space', description: 'Start with the width and length of a rectangular room, then check the tile dimensions on your product packaging.' },
  { title: 'Add your details', description: 'Enter an allowance and tiles per box. Add a box price for a budget, or grout and a starting point for a layout.' },
  { title: 'Review before you buy', description: 'Compare the estimate with your layout. Check edge cuts, product details and final quantities with your installer.' },
];
---
<SiteLayout title="Plan your tile purchase" description="Estimate tiles and full boxes, explore a straight-grid room layout, and learn how to measure and plan before buying tile.">
  <section class="overflow-hidden border-b border-line bg-linear-to-br from-white via-[#f5fafb] to-[#e8f4f5]" aria-labelledby="home-heading">
    <div class="shell relative grid gap-8 py-12 sm:py-16 lg:grid-cols-[1.2fr_0.8fr] lg:items-center lg:gap-12">
      <div class="relative z-10">
        <p class="eyebrow">Plan smarter. Tile with confidence.</p>
        <h1 id="home-heading" class="mt-4 max-w-2xl text-4xl leading-[1.1] font-bold tracking-tight sm:text-5xl lg:text-[3.5rem]">Better spaces start with a plan<span class="text-teal">.</span></h1>
        <p class="mt-5 max-w-xl text-lg leading-8 text-muted">Estimate how many tiles to buy, explore your room layout, and understand the numbers before you shop.</p>
        <div class="mt-7 flex flex-col gap-3 sm:flex-row">
          <a href="/calculator/" class="btn-primary">Try the tile calculator <span aria-hidden="true">→</span></a>
          <a href="/layout/" class="btn-secondary border border-[#b6d7de] bg-white px-6">Plan your layout <span aria-hidden="true">→</span></a>
        </div>
        <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-3 text-xs text-muted sm:text-sm" aria-label="Tool features">
          {['Free to use', 'US & metric units', 'No sign-up'].map(feature => <li class="flex items-center gap-2"><span class="flex size-5 items-center justify-center rounded-full bg-[#d9eef1] font-bold text-teal" aria-hidden="true">✓</span>{feature}</li>)}
        </ul>
      </div>
      <figure class="mx-auto hidden w-full max-w-md rounded-2xl border border-[#cfe3e7] bg-white p-5 shadow-lg shadow-ink/5 lg:block">
        <div class="mb-2 flex items-center justify-between gap-3"><p class="text-sm font-semibold">Find your starting point.</p><span class="text-[10px] font-bold tracking-wider text-teal">A REAL WORKED EXAMPLE</span></div>
        <img src="/diagrams/starting-point/center.svg" width="480" height="565" class="h-64 w-full object-contain" alt="Centered layout example with equal opposite edge pieces in a 3200 by 4100 millimeter room." />
        <figcaption class="border-t border-line pt-3 text-xs leading-5 text-muted">A straight grid, balanced edges and dimensions you can check. <a href="/guides/tile-layout-starting-point/" class="font-semibold text-teal underline underline-offset-2">Explore this example →</a></figcaption>
      </figure>
    </div>
  </section>

  <div class="shell">
    <section class="pt-10 sm:pt-12" aria-labelledby="tools-heading">
      <h2 id="tools-heading" class="text-2xl font-bold tracking-tight">Two tools. A clearer starting point.</h2>
      <p class="mt-2 text-sm leading-6 text-muted">From your first measurements to your shopping list and floor plan.</p>
      <div class="mt-5 grid gap-5 md:grid-cols-2">
        {tools.map(tool => (
          <article class="overflow-hidden rounded-2xl border border-line bg-white">
            <div class="p-5 sm:p-6">
              <p class="eyebrow">{tool.label}</p>
              <h3 class="mt-3 text-2xl font-bold tracking-tight">{tool.title}</h3>
              <p class="mt-3 max-w-lg text-sm leading-6 text-muted">{tool.description}</p>
              <a href={tool.href} class="mt-5 inline-flex min-h-11 items-center gap-3 text-sm font-semibold text-teal hover:underline">{tool.link} <span aria-hidden="true">→</span></a>
            </div>
            <figure class="border-t border-line bg-[#f0f7f9] px-4 pt-4 sm:px-6 sm:pt-5">
              <div class="aspect-[1.85] overflow-hidden rounded-t-lg border border-b-0 border-line bg-white">
                <img src={`/assets/previews/${tool.image}`} alt={tool.alt} width="1425" height={tool.height} loading="lazy" decoding="async" class="h-full w-full object-cover object-[center_27%]" />
              </div>
              <figcaption class="py-2 text-center text-[11px] text-muted">Actual tool screen · example inputs shown</figcaption>
            </figure>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-10 sm:mt-12" aria-labelledby="guides-heading">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div><h2 id="guides-heading" class="text-2xl font-bold tracking-tight">Helpful guides, from measure to purchase.</h2><p class="mt-2 text-sm leading-6 text-muted">Practical explanations. Worked examples you can try yourself.</p></div>
        <a href="/guides/" class="inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-teal hover:underline">View all guides <span aria-hidden="true">→</span></a>
      </div>
      <ul class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {guides.map((guide, index) => (
          <li>
            <a href={`/guides/${guide.id}/`} aria-labelledby={`home-guide-${index}`} class="group flex h-full flex-col rounded-xl border border-line bg-white p-5 transition hover:border-teal hover:bg-[#f5fafb]">
              <span class="mb-4 flex size-9 items-center justify-center rounded-lg bg-[#edf7f9] text-sm font-semibold text-teal" aria-hidden="true">0{index + 1}</span>
              <p class="text-xs font-semibold text-teal">{guide.data.topic}</p>
              <h3 id={`home-guide-${index}`} class="mt-2 text-base leading-6 font-bold group-hover:text-teal">{guide.data.title}</h3>
              <p class="mt-3 flex-1 text-sm leading-6 text-muted">{guide.data.description}</p>
              <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-teal">Read guide <span aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section id="how-it-works" class="mt-10 rounded-2xl border border-[#d9e9ed] bg-[#edf7f9] p-6 sm:mt-12 sm:p-8" aria-labelledby="workflow-heading">
      <p class="eyebrow">From room to results</p>
      <h2 id="workflow-heading" class="mt-3 text-2xl font-bold tracking-tight">A plan in three simple steps.</h2>
      <ol class="mt-6 grid gap-7 md:grid-cols-3">
        {steps.map((step, index) => <li class="flex items-start gap-4"><span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-teal text-sm font-bold text-white" aria-hidden="true">{index + 1}</span><div><h3 class="font-bold">{step.title}</h3><p class="mt-2 text-sm leading-6 text-muted">{step.description}</p></div></li>)}
      </ol>
    </section>

    <aside class="mt-10 grid gap-5 border-t border-line pt-8 sm:mt-12 md:grid-cols-[0.8fr_1.2fr] md:gap-12" aria-labelledby="scope-heading">
      <div><p class="eyebrow">Know what goes into your plan</p><h2 id="scope-heading" class="mt-3 text-2xl font-bold tracking-tight">A planning aid, before you place an order.</h2></div>
      <div class="space-y-3 text-sm leading-7 text-muted">
        <p>The calculator estimates one rectangular area, adds your chosen allowance and rounds up to full boxes. Optional cost is USD for tile boxes only; tax, delivery, installation and other materials are excluded.</p>
        <p>The layout shows a straight grid at 0° or 90°. It does not model irregular rooms, diagonal or herringbone patterns, perimeter movement gaps or offcut reuse. Placed pieces are not a minimum purchase quantity. Preview drawing is limited to 2,500 pieces; larger plans retain counts and dimensions.</p>
        <p>Use both tools to prepare your questions, then confirm measurements, tile specifications and quantities with your installer or supplier. Inputs run in your browser and are not saved in browser storage.</p>
        <a href="/calculator/#calculation-method" class="inline-flex min-h-11 items-center gap-2 font-semibold text-teal underline underline-offset-4">Understand the calculation <span aria-hidden="true">→</span></a>
      </div>
    </aside>
  </div>
</SiteLayout>
