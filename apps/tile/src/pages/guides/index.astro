---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

const guides = (await getCollection('guides')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title, 'en') || a.id.localeCompare(b.id, 'en')
);
---
<SiteLayout title="Tile planning guides" description="Practical guides to measuring a room, choosing a tile waste allowance, buying full boxes and comparing layout starting points.">
  <div class="shell py-10 sm:py-14">
    <header class="max-w-3xl">
      <p class="eyebrow">From measurements to materials</p>
      <h1 class="mt-4 text-4xl leading-tight font-bold tracking-tight sm:text-5xl">A little guidance for your next tile project.</h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-muted">Understand the numbers before you shop. Explore practical explanations and worked examples, then try the same inputs in our planning tools.</p>
    </header>

    <section class="mt-10 sm:mt-12" aria-labelledby="guides-heading">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h2 id="guides-heading" class="text-2xl font-bold tracking-tight">Explore the guides</h2>
        <p class="text-sm text-muted">{guides.length} {guides.length === 1 ? 'guide' : 'guides'}</p>
      </div>
      <ul class="mt-6 grid gap-5 md:grid-cols-2">
        {guides.map((guide, index) => (
          <li>
            <a href={`/guides/${guide.id}/`} aria-labelledby={`guide-title-${index}`} class="panel group flex h-full flex-col transition hover:border-teal hover:bg-[#f5fafb]">
              <p class="eyebrow">{guide.data.topic}</p>
              <h3 id={`guide-title-${index}`} class="mt-4 text-xl leading-7 font-bold tracking-tight group-hover:text-teal">{guide.data.title}</h3>
              <p class="mt-3 flex-1 text-sm leading-7 text-muted">{guide.data.description}</p>
              <span class="mt-6 inline-flex items-center gap-3 text-sm font-semibold text-teal">Read guide <span aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <aside class="mt-10 rounded-2xl border border-[#d9e9ed] bg-[#edf7f9] p-6 sm:mt-12 sm:p-8" aria-labelledby="tools-heading">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
        <div class="max-w-xl">
          <h2 id="tools-heading" class="text-2xl font-bold tracking-tight">Put your measurements to work.</h2>
          <p class="mt-3 text-sm leading-7 text-muted">Estimate tiles and full boxes, or compare straight-grid layouts and edge pieces. Both tools explain their assumptions as you plan.</p>
        </div>
        <div class="flex shrink-0 flex-col items-stretch gap-2 sm:flex-row sm:items-center">
          <a href="/calculator/" class="btn-primary">Tile calculator <span aria-hidden="true">→</span></a>
          <a href="/layout/" class="btn-secondary">Layout planner <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </aside>
  </div>
</SiteLayout>
