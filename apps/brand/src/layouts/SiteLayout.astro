---
import '../styles/global.css';
interface Props { title: string; description: string; noindex?: boolean; }
const { title, description, noindex = false } = Astro.props;
const name = import.meta.env.PROJECT_BRAND_NAME;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const verification = Astro.site && Astro.url.pathname === '/' ? import.meta.env.PROJECT_GOOGLE_SITE_VERIFICATION : undefined;
const publisher = Astro.site && Astro.url.pathname === '/' ? import.meta.env.PROJECT_ADSENSE_PUBLISHER : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#182f3c" />
    {verification && <meta name="google-site-verification" content={verification} />}
    {publisher && <meta name="google-adsense-account" content={`ca-${publisher}`} />}
    <meta name="robots" content={!Astro.site || noindex ? 'noindex, nofollow' : 'index, follow'} />
    <title>{title} | {name}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={`${title} | ${name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={name} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-3 focus:z-50 focus:rounded focus:bg-white focus:p-3">Skip to content</a>
    <header class="border-b border-line bg-white">
      <div class="shell flex min-h-20 flex-col items-start justify-between gap-4 py-5 sm:flex-row sm:items-center sm:gap-5 sm:py-0">
        <a href="/" class="text-xl font-bold tracking-tight">{name}<span class="text-teal" aria-hidden="true">.</span></a>
        <nav aria-label="Main navigation" class="flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium text-muted"><a href="/#projects" class="hover:text-teal">Projects</a><a href="/#approach" class="hover:text-teal">The approach</a><a href="/about/" class="hover:text-teal" aria-current={Astro.url.pathname === '/about/' ? 'page' : undefined}>About</a><a href="/contact/" class="hover:text-teal" aria-current={Astro.url.pathname === '/contact/' ? 'page' : undefined}>Contact</a></nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="mt-16 border-t border-line py-8">
      <div class="shell flex flex-wrap items-center justify-between gap-4 text-sm text-muted"><a href="/" class="font-semibold text-ink">{name}</a><p>Practical tools. Explained clearly.</p><a href="/contact/" class="text-link">Contact & error reports</a><a href="/privacy/" class="text-link">Privacy & data</a></div>
    </footer>
  </body>
</html>
